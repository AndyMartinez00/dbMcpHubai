# =====================================================================
#  Conexiones para el servidor MCP de bases de datos (scripts/db-mcp.mjs)
#  Copiar a .env y completar. El .env NO se sube al repositorio.
#
#  Cada conexión es un bloque con el prefijo CONN_<NOMBRE>_
#  <NOMBRE>: MAYÚSCULAS, números y _ ; se recomienda <SISTEMA>_<QA|PR>
#
#  Campos:
#    TYPE         postgres | mysql | mariadb | sqlserver | oracle | sqlite   (obligatorio)
#    HOST         servidor                                    (obligatorio salvo sqlite)
#    PORT         opcional; por defecto 5432 / 3306 / 1433 / 1521
#    DATABASE     nombre de la base (en sqlite: ruta del archivo)  (obligatorio)
#    USER         usuario                                     (obligatorio salvo sqlite)
#    PASSWORD     contraseña tal cual, SIN codificar; usar comillas simples si tiene # o espacios
#    READONLY     true (por defecto) | false   -> en PR dejar SIEMPRE true
#    MAX_ROWS     máximo de filas por consulta (por defecto 1000)
#    DESCRIPTION  texto libre que verá el asistente
#    SSLMODE      solo PostgreSQL: disable | require | verify-ca | verify-full
#    INSTANCE     solo SQL Server: nombre de instancia (ej. SQLEXPRESS)
#
#  Ver conexiones cargadas:  npm run list
# =====================================================================

# --- PostgreSQL - PR ---------------------------------------------------
CONN_VENTAS_PR_TYPE=postgres
CONN_VENTAS_PR_HOST=db_host
CONN_VENTAS_PR_PORT=5432
CONN_VENTAS_PR_DATABASE=db_name
CONN_VENTAS_PR_USER=db_user
CONN_VENTAS_PR_PASSWORD='db_password'
CONN_VENTAS_PR_READONLY=true
CONN_VENTAS_PR_DESCRIPTION="PostgreSQL ventas - PRODUCCIÓN"

# --- PostgreSQL - QA ---------------------------------------------------
CONN_VENTAS_QA_TYPE=postgres
CONN_VENTAS_QA_HOST=db_host
CONN_VENTAS_QA_PORT=5432
CONN_VENTAS_QA_DATABASE=db_name
CONN_VENTAS_QA_USER=db_user
CONN_VENTAS_QA_PASSWORD='db_password'
CONN_VENTAS_QA_READONLY=true
CONN_VENTAS_QA_DESCRIPTION="PostgreSQL ventas - QA"

